classDiagram
    class Owner {
        +String firstName
        +String lastName
        +List~Pet~ pets
        +addPet(pet Pet) void
        +getAllTasks() List~Task~
    }

    class Pet {
        +String name
        +String species
        +Owner owner
        +List~Task~ tasks
        +addTask(task Task) void
    }

    class Task {
        +String name
        +int duration
        +Priority priority
        +Frequency frequency
        +bool completed
        +Pet pet
    }

    class Priority {
        <<enumeration>>
        HIGH
        MEDIUM
        LOW
    }

    class Frequency {
        <<enumeration>>
        ONCE
        DAILY
        WEEKLY
    }

    class Scheduler {
        +Owner owner
        +sortByPriority() List~Task~
        +generateDailySchedule() List~Task~
    }

    Owner "1" --> "1..*" Pet : owns
    Pet "1" --> "0..*" Task : has
    Scheduler "1" --> "1" Owner : plans for
    Scheduler ..> Task : orders
    Task --> Priority : has
    Task --> Frequency : repeats
